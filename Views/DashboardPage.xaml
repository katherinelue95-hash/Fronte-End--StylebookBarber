<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================
     DashboardPage — wireframe Stitch (zip1) · Atelier Noir
     MVVM: DashboardViewModel
     ============================================================ -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StyleBookBarberApp.ViewModels"
             xmlns:helpers="clr-namespace:StyleBookBarberApp.Helpers"
             x:Class="StyleBookBarberApp.Views.DashboardPage"
             x:DataType="vm:DashboardViewModel"
             Title="Inicio"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,40" Spacing="20">

            <!-- ===== Encabezado: marca + notificaciones + avatar ===== -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" Margin="0,4,0,0">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="StyleBook" FontFamily="BodoniModa" FontSize="20"
                           FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Border BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            StrokeShape="RoundRectangle 6" Padding="8,3">
                        <Label Text="BARBER" Style="{StaticResource LabelSM}"
                               TextColor="{StaticResource Outline}" />
                    </Border>
                </HorizontalStackLayout>

                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <Border WidthRequest="40" HeightRequest="40"
                            StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirNotificacionesCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static helpers:IconGlyphs.Notifications}"
                               Style="{StaticResource IconGlyph}" FontSize="20"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border WidthRequest="36" HeightRequest="36"
                            StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource Primary}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirPerfilCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static helpers:IconGlyphs.Person}"
                               Style="{StaticResource IconGlyph}" FontSize="18"
                               TextColor="{StaticResource OnPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ===== Saludo personalizado ===== -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="{Binding Greeting, StringFormat='Hola, {0}'}"
                           Style="{StaticResource HeadlineLGMobile}" />
                    <Label Text="Bienvenido de vuelta a tu espacio"
                           Style="{StaticResource BodyMD}"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>
                <Border Grid.Column="1" WidthRequest="48" HeightRequest="48"
                        VerticalOptions="Start"
                        StrokeShape="RoundRectangle 24"
                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        Stroke="{StaticResource GoldStrokeStrong}" StrokeThickness="1">
                    <Grid>
                        <Label Text="{x:Static helpers:IconGlyphs.Spa}"
                               Style="{StaticResource IconGlyph}" FontSize="24"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                        <BoxView Style="{StaticResource StatusDot}"
                                 WidthRequest="10" HeightRequest="10"
                                 HorizontalOptions="End" VerticalOptions="Start"
                                 Margin="0,8,8,0" />
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Tarjeta Próxima Cita (borde dorado) ===== -->
            <Border Style="{StaticResource CardGold}">
                <!-- halo dorado ambiental -->
                <Grid>
                    <BoxView Color="#14D4AF37" InputTransparent="True"
                             WidthRequest="120" HeightRequest="120"
                             CornerRadius="60" HorizontalOptions="End" VerticalOptions="Start"
                             Margin="0,-36,-36,0" />
                    <VerticalStackLayout Spacing="14">
                        <!-- encabezado cita + estado -->
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <BoxView Style="{StaticResource StatusDot}" VerticalOptions="Center" />
                                <Label Text="PRÓXIMA CITA" Style="{StaticResource LabelGold}"
                                       TextColor="{StaticResource Primary}" FontSize="10" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1" BackgroundColor="#26D4AF37"
                                    StrokeShape="RoundRectangle 9999" Padding="10,4">
                                <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                    <Label Text="{x:Static helpers:IconGlyphs.Verified}"
                                           Style="{StaticResource IconGlyph}" FontSize="13"
                                           TextColor="{StaticResource Primary}" />
                                    <Label Text="CONFIRMADA" Style="{StaticResource LabelSM}"
                                           TextColor="{StaticResource Primary}" FontSize="9" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- servicio + barbero -->
                        <Grid ColumnDefinitions="64,*,8" ColumnSpacing="12">
                            <Border WidthRequest="64" HeightRequest="64"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource SurfaceContainerHighest}"
                                    Stroke="{StaticResource GoldStroke}" StrokeThickness="1">
                                <Label Text="{x:Static helpers:IconGlyphs.Scissors}"
                                       Style="{StaticResource IconGlyph}" FontSize="28"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                <Label Text="{Binding ServiceName}" Style="{StaticResource HeadlineSM}"
                                       LineBreakMode="TailTruncation" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static helpers:IconGlyphs.Face}"
                                           Style="{StaticResource IconGlyph}" FontSize="15"
                                           TextColor="{StaticResource Primary}" />
                                    <Label Text="{Binding BarberName}" Style="{StaticResource BodyMD}"
                                           LineBreakMode="TailTruncation" />
                                    <Border BackgroundColor="{StaticResource SurfaceContainer}"
                                            StrokeShape="RoundRectangle 9999" Padding="8,2" VerticalOptions="Center">
                                        <Label Text="{Binding BarberRank}" Style="{StaticResource LabelSM}"
                                               TextColor="{StaticResource Outline}" FontSize="9" />
                                    </Border>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Grid>

                        <!-- fecha + horario + acciones -->
                        <Border BackgroundColor="#D90E0E0E"
                                StrokeShape="RoundRectangle 12" Padding="12">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <HorizontalStackLayout Spacing="12">
                                    <Border WidthRequest="40" HeightRequest="40"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{StaticResource SurfaceContainer}">
                                        <Label Text="{x:Static helpers:IconGlyphs.CalendarToday}"
                                               Style="{StaticResource IconGlyph}" FontSize="20"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                        <Label Text="{Binding AppointmentDay}" Style="{StaticResource TitleMD}" />
                                        <HorizontalStackLayout Spacing="5">
                                            <Label Text="{x:Static helpers:IconGlyphs.Schedule}"
                                                   Style="{StaticResource IconGlyph}" FontSize="14"
                                                   TextColor="{StaticResource Primary}" />
                                            <Label Text="{Binding AppointmentTime}" Style="{StaticResource BodySM}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </HorizontalStackLayout>
                                <Border Grid.Column="1" WidthRequest="36" HeightRequest="36"
                                        StrokeShape="RoundRectangle 18"
                                        BackgroundColor="{StaticResource SurfaceContainerHigh}">
                                    <Label Text="{x:Static helpers:IconGlyphs.MoreVert}"
                                           Style="{StaticResource IconGlyph}" FontSize="17"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </Border>

            <!-- ===== Agendamiento Express (CTA dorado gigante) ===== -->
            <Border Background="{StaticResource GoldGradient}"
                    StrokeShape="RoundRectangle 14" Padding="16,14">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoToExpressBookingCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="36,*,36" ColumnSpacing="10">
                    <Border WidthRequest="32" HeightRequest="32"
                            StrokeShape="RoundRectangle 16"
                            BackgroundColor="#26FFFFFF">
                        <Label Text="{x:Static helpers:IconGlyphs.Bolt}"
                               Style="{StaticResource IconGlyph}" FontSize="18"
                               TextColor="{StaticResource OnPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                        <Label Text="AGENDAMIENTO EXPRESS"
                               FontFamily="PlusJakartaSans" FontSize="14" FontAttributes="Bold"
                               CharacterSpacing="1.2" TextColor="{StaticResource OnPrimary}" />
                        <Label Text="Repetir última cita reservada"
                               FontFamily="PlusJakartaSans" FontSize="10"
                               TextColor="{StaticResource OnPrimary}"
                               Opacity="0.8" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="{x:Static helpers:IconGlyphs.ArrowForward}"
                           FontFamily="MaterialSymbolsOutlined" FontSize="20"
                           TextColor="{StaticResource OnPrimary}"
                           VerticalOptions="Center" HorizontalOptions="Center" />
                </Grid>
            </Border>
            <Label Text="Agenda en 1 solo toque con Carlos Mendoza al horario habitual"
                   Style="{StaticResource BodySM}"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   HorizontalTextAlignment="Center" Margin="0,-8,0,0" />

            <!-- ===== Accesos Rápidos ===== -->
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Accesos Rápidos" Style="{StaticResource HeadlineSM}" />
                <Label Grid.Column="1" Text="GESTIÓN" Style="{StaticResource LabelSM}"
                       TextColor="{StaticResource Outline}" VerticalOptions="Center" />
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <!-- Historial -->
                <Border Style="{StaticResource CardLow}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToHistorialCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}">
                                <Label Text="{x:Static helpers:IconGlyphs.History}"
                                       Style="{StaticResource IconGlyph}" FontSize="20"
                                       TextColor="{StaticResource Secondary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceContainerHighest}"
                                    StrokeShape="RoundRectangle 9999" Padding="8,3" VerticalOptions="Start">
                                <Label Text="{Binding HistoryCount}" Style="{StaticResource LabelSM}"
                                       TextColor="{StaticResource OnSurfaceVariant}" FontSize="9" />
                            </Border>
                        </Grid>
                        <Label Text="Historial" Style="{StaticResource TitleMD}" />
                        <Label Text="{Binding HistoryCaption}" Style="{StaticResource BodySM}"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               MaxLines="2" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="Ver sesiones" Style="{StaticResource LabelBodyGold}" FontSize="11" />
                            <Label Text="{x:Static helpers:IconGlyphs.ArrowForward}"
                                   Style="{StaticResource IconGlyph}" FontSize="13"
                                   TextColor="{StaticResource Primary}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Catálogo -->
                <Border Grid.Column="1" Style="{StaticResource CardLow}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToCatalogoCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource SurfaceContainerHigh}">
                                <Label Text="{x:Static helpers:IconGlyphs.MenuBook}"
                                       Style="{StaticResource IconGlyph}" FontSize="20"
                                       TextColor="{StaticResource Primary}"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Border Grid.Column="1" BackgroundColor="#26D4AF37"
                                    StrokeShape="RoundRectangle 9999" Padding="8,3" VerticalOptions="Start">
                                <Label Text="TARIFAS" Style="{StaticResource LabelSM}"
                                       TextColor="{StaticResource Primary}" FontSize="9" />
                            </Border>
                        </Grid>
                        <Label Text="Catálogo" Style="{StaticResource TitleMD}" />
                        <Label Text="Explora técnicas de tijera, afeitado ritual y diseño"
                               Style="{StaticResource BodySM}"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               MaxLines="2" LineBreakMode="TailTruncation" />
                        <HorizontalStackLayout Spacing="4">
                            <Label Text="Consultar" Style="{StaticResource LabelBodyGold}" FontSize="11" />
                            <Label Text="{x:Static helpers:IconGlyphs.ArrowForward}"
                                   Style="{StaticResource IconGlyph}" FontSize="13"
                                   TextColor="{StaticResource Primary}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <!-- ===== Banner editorial "Consejo de Estilo" ===== -->
            <Border BackgroundColor="{StaticResource SurfaceContainerHigh}"
                    StrokeShape="RoundRectangle 16" Padding="16">
                <Grid ColumnDefinitions="*,64,8" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label Text="CONSEJO DE ESTILO" Style="{StaticResource LabelGold}"
                               TextColor="{StaticResource Primary}" FontSize="10" />
                        <Label Text="Mantenimiento de Barba" Style="{StaticResource HeadlineSM}"
                               LineBreakMode="TailTruncation" />
                        <Label Text="Revisa tu loción astringente tras cada afeitado al vapor."
                               Style="{StaticResource BodySM}"
                               TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1" WidthRequest="64" HeightRequest="64"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource SurfaceContainer}"
                        Stroke="{StaticResource GoldStroke}" StrokeThickness="1">
                    <Image Source="barba1.jpg" Aspect="AspectFill" />
                </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>