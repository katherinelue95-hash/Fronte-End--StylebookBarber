<?xml version="1.0" encoding="utf-8" ?>
<!--
     RegisterPage — Creación de cuenta de Cliente · Atelier Noir
     MVVM: RegisterViewModel · Solo clientes (el backend asigna RolId = 1)
-->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StyleBookBarberApp.ViewModels"
             xmlns:helpers="clr-namespace:StyleBookBarberApp.Helpers"
             x:Class="StyleBookBarberApp.Views.RegisterPage"
             x:DataType="vm:RegisterViewModel"
             Title="Crear cuenta"
             BackgroundColor="{StaticResource Surface}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,40" Spacing="18">

            <!-- ===== Logo + Marca ===== -->
            <VerticalStackLayout Spacing="10" Margin="0,4,0,4">
                <Image Source="logo.png"
                       Aspect="AspectFit"
                       WidthRequest="{OnIdiom Phone=150, Tablet=230}"
                       HorizontalOptions="Center"
                       SemanticProperties.Description="Logo de StyleBook Barber" />
                <Label Text="STYLEBOOK BARBER"
                       Style="{StaticResource LabelGold}"
                       FontSize="16" CharacterSpacing="2.5"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- ===== Encabezado de sesión ===== -->
            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                <Label Text="Crear cuenta" Style="{StaticResource HeadlineLGMobile}"
                       HorizontalTextAlignment="Center" />
                <Label Text="Únete al club StyleBook Barber"
                       Style="{StaticResource BodyMD}"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- ===== Campo nombre ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="NOMBRE" Style="{StaticResource LabelLG}"
                       TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" />
                <Border Style="{StaticResource InputContainer}">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="6">
                        <Label Text="{x:Static helpers:IconGlyphs.Person}"
                               Style="{StaticResource IconGlyph}"
                               TextColor="{StaticResource Outline}" FontSize="20"
                               VerticalOptions="Center" HorizontalOptions="Center" />
                        <Entry Grid.Column="1"
                               Style="{StaticResource EntryDark}"
                               Placeholder="Tu nombre"
                               Text="{Binding Nombre}"
                               ReturnType="Next"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ===== Campo apellido ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="APELLIDO" Style="{StaticResource LabelLG}"
                       TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" />
                <Border Style="{StaticResource InputContainer}">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="6">
                        <Label Text="{x:Static helpers:IconGlyphs.PersonOutline}"
                               Style="{StaticResource IconGlyph}"
                               TextColor="{StaticResource Outline}" FontSize="20"
                               VerticalOptions="Center" HorizontalOptions="Center" />
                        <Entry Grid.Column="1"
                               Style="{StaticResource EntryDark}"
                               Placeholder="Tu apellido"
                               Text="{Binding Apellido}"
                               ReturnType="Next"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ===== Campo correo electrónico ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="CORREO ELECTRÓNICO" Style="{StaticResource LabelLG}"
                       TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" />
                <Border Style="{StaticResource InputContainer}">
                    <Grid ColumnDefinitions="36,*" ColumnSpacing="6">
                        <Label Text="{x:Static helpers:IconGlyphs.AlternateEmail}"
                               Style="{StaticResource IconGlyph}"
                               TextColor="{StaticResource Outline}" FontSize="20"
                               VerticalOptions="Center" HorizontalOptions="Center" />
                        <Entry Grid.Column="1"
                               Style="{StaticResource EntryDark}"
                               Placeholder="ejemplo@correo.com"
                               Keyboard="Email"
                               Text="{Binding Correo}"
                               ReturnType="Next"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ===== Campo contraseña ===== -->
            <VerticalStackLayout Spacing="8">
                <Label Text="CONTRASEÑA" Style="{StaticResource LabelLG}"
                       TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" />
                <Border Style="{StaticResource InputContainer}">
                    <Grid ColumnDefinitions="36,*,36">
                        <Label Text="{x:Static helpers:IconGlyphs.Lock}"
                               Style="{StaticResource IconGlyph}"
                               TextColor="{StaticResource Outline}" FontSize="20"
                               VerticalOptions="Center" HorizontalOptions="Center" />
                        <Entry Grid.Column="1"
                               Style="{StaticResource EntryDark}"
                               Placeholder="Mínimo 6 caracteres"
                               IsPassword="{Binding IsPassword}"
                               Text="{Binding Contrasena}"
                               ReturnType="Go"
                               VerticalOptions="Center" />
                        <Label Grid.Column="2"
                               Text="{Binding VisibilityGlyph}"
                               Style="{StaticResource IconGlyph}"
                               TextColor="{StaticResource Outline}" FontSize="20"
                               VerticalOptions="Center" HorizontalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding TogglePasswordCommand}" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- ===== Mensaje de error ===== -->
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource BodySM}"
                   TextColor="{StaticResource Error}"
                   HorizontalTextAlignment="Center"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotNullConverter}}" />

            <!-- ===== Botón dorado principal ===== -->
            <Button Text="CREAR CUENTA"
                    Style="{StaticResource GoldButton}"
                    Command="{Binding RegistrarCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

            <!-- ===== Volver al login ===== -->
            <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                <Label Text="¿Ya tienes cuenta?" Style="{StaticResource BodyMD}"
                       TextColor="{StaticResource OnSurfaceVariant}" />
                <Label Text="Inicia sesión" Style="{StaticResource TitleMD}"
                       TextColor="{StaticResource Primary}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VolverCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>