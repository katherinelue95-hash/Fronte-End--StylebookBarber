<?xml version="1.0" encoding="utf-8" ?>
<!-- ============================================================
     BarberosPage — Agenda del Día del barbero (wireframe Stitch: dl3)
     Cabecera especialista + progreso + filtros + citas.
     ============================================================ -->
<ContentPage x:Name="Root"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:StyleBookBarberApp.ViewModels"
             xmlns:m="clr-namespace:StyleBookBarberApp.Models"
             xmlns:helpers="clr-namespace:StyleBookBarberApp.Helpers"
             x:Class="StyleBookBarberApp.Views.BarberosPage"
             x:DataType="vm:BarberosViewModel"
             Title="Barbero"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,16,20,32" Spacing="18">

            <!-- ===== Header marca ===== -->
            <Grid ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Label Text="StyleBook" FontFamily="BodoniModa" FontSize="20"
                           FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                    <Border BackgroundColor="{StaticResource SurfaceContainerHigh}"
                            StrokeShape="RoundRectangle 6" Padding="8,3">
                        <Label Text="BARBER" Style="{StaticResource LabelSM}" />
                    </Border>
                </HorizontalStackLayout>
                <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 20"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirNotificacionesCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static helpers:IconGlyphs.Notifications}"
                               Style="{StaticResource IconGlyph}" FontSize="20"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Border WidthRequest="36" HeightRequest="36" StrokeShape="RoundRectangle 18"
                            BackgroundColor="{StaticResource Primary}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AbrirPerfilCommand}" />
                        </Border.GestureRecognizers>
                        <Label Text="{x:Static helpers:IconGlyphs.Person}"
                               Style="{StaticResource IconGlyph}" FontSize="18"
                               TextColor="{StaticResource OnPrimary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>

            <!-- ===== Identidad del especialista ===== -->
            <Grid ColumnDefinitions="*,Auto">
                <HorizontalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <BoxView Style="{StaticResource StatusDot}" WidthRequest="7" HeightRequest="7"
                                 VerticalOptions="Center" />
                        <Label Text="{Binding Especialista}" Style="{StaticResource LabelSM}"
                               TextColor="{StaticResource Primary}"
                               BackgroundColor="{StaticResource SurfaceContainerHighest}"
                               Padding="10,4" HorizontalTextAlignment="Center" FontSize="9" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding Sillon}" Style="{StaticResource BodySM}"
                           TextColor="{StaticResource OnSurfaceVariant}" FontSize="11"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Border Grid.Column="1" BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        StrokeShape="RoundRectangle 9999" Padding="10,5">
                    <HorizontalStackLayout Spacing="5">
                        <Label Text="{x:Static helpers:IconGlyphs.CalendarToday}"
                               Style="{StaticResource IconGlyph}" FontSize="14"
                               TextColor="{StaticResource Primary}" />
                        <Label Text="{Binding ContadorHoy}" Style="{StaticResource LabelSM}"
                               TextColor="{StaticResource Primary}" FontSize="9"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- ===== Título + progreso % ===== -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="2">
                    <Label Text="Agenda del Día" Style="{StaticResource HeadlineLGMobile}" />
                    <Label Text="{Binding Subtitulo}" Style="{StaticResource BodyMD}"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1" Spacing="0" HorizontalOptions="End">
                    <Label Text="25%" FontFamily="BodoniModa" FontSize="22" FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" HorizontalTextAlignment="End" />
                    <Label Text="PROGRESO" Style="{StaticResource LabelSM}"
                           TextColor="{StaticResource Outline}" FontSize="8" HorizontalTextAlignment="End" />
                </VerticalStackLayout>
            </Grid>

            <!-- ===== Barra de progreso ===== -->
            <ProgressBar Progress="0.25"
                         ProgressColor="{StaticResource Primary}"
                         BackgroundColor="{StaticResource SurfaceContainerHighest}"
                         HeightRequest="8" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{Binding TituloProgreso}" Style="{StaticResource BodySM}"
                       TextColor="{StaticResource OnSurfaceVariant}" FontSize="11" />
                <Label Grid.Column="1" Text="{Binding LigeraDerecha}" Style="{StaticResource LabelSM}"
                       TextColor="{StaticResource Outline}" FontSize="9" />
            </Grid>

            <!-- ===== Filtros por estado ===== -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8"
                                       BindableLayout.ItemsSource="{Binding Filtros}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="m:FiltroCategoria">
                            <Border BackgroundColor="{Binding Fondo}"
                                    StrokeShape="RoundRectangle 9999" Padding="14,9">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.FiltrarCommand, Source={x:Reference Root}}"
                                        CommandParameter="{Binding Nombre}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Nombre}" Style="{StaticResource LabelLG}"
                                           TextColor="{Binding TextoColor}"
                                           FontSize="11" CharacterSpacing="1" />
                                    <Label Text="{Binding Count}"
                                           BackgroundColor="{Binding ContadorFondo}"
                                           TextColor="{Binding ContadorTextoColor}"
                                           FontFamily="PlusJakartaSans" FontSize="10" FontAttributes="Bold"
                                           Padding="6,2" HorizontalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- ===== Lista de citas ===== -->
            <VerticalStackLayout Spacing="14"
                                 BindableLayout.ItemsSource="{Binding Visibles}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="m:CitaAgenda">
                        <Border BackgroundColor="{Binding Fondo}"
                                Stroke="{StaticResource GoldStroke}"
                                StrokeThickness="{Binding TurnoActualVisible, Converter={StaticResource BoolToIntConverter}, ConverterParameter=1;0}"
                                StrokeShape="RoundRectangle 14" Padding="14"
                                Margin="0,4,0,0">
                            <Grid>
                                <VerticalStackLayout Spacing="12">
                                    <!-- Badge flotante: Turno Actual -->
                                    <Border BackgroundColor="{StaticResource Primary}"
                                            StrokeShape="RoundRectangle 9999" Padding="10,4"
                                            HorizontalOptions="End"
                                            IsVisible="{Binding TurnoActualVisible}">
                                        <Label Text="TURNO ACTUAL" Style="{StaticResource LabelSM}"
                                               TextColor="{StaticResource OnPrimary}" FontSize="8" />
                                    </Border>

                                    <!-- Cabecera: avatar + nombre | hora -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Grid>
                                            <!-- Avatar -->
                                            <Border WidthRequest="{Binding AvatarSize}" HeightRequest="{Binding AvatarSize}"
                                                    StrokeShape="RoundRectangle 9999"
                                                    BackgroundColor="{StaticResource SurfaceContainerHighest}"
                                                    HorizontalOptions="Start" VerticalOptions="Start">
                                                <Label Text="{x:Static helpers:IconGlyphs.Person}"
                                                       Style="{StaticResource IconGlyph}" FontSize="20"
                                                       TextColor="{StaticResource OnSurfaceVariant}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <!-- Badge de estado en avatar -->
                                            <Border WidthRequest="20" HeightRequest="20"
                                                    StrokeShape="RoundRectangle 9999"
                                                    BackgroundColor="{Binding AvatarBadgeFondo}"
                                                    HorizontalOptions="End" VerticalOptions="End"
                                                    Margin="0,0,-2,-2">
                                                <Label Text="{Binding AvatarBadgeIcono}"
                                                       Style="{StaticResource IconGlyph}" FontSize="11"
                                                       TextColor="{Binding AvatarBadgeColor}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <!-- Columna nombre/servicio -->
                                            <VerticalStackLayout Margin="60,0,0,0" Spacing="2" VerticalOptions="Center">
                                                <HorizontalStackLayout Spacing="6">
                                                    <Label Text="{Binding Nombre}" Style="{StaticResource TitleMD}"
                                                           FontSize="15" LineBreakMode="TailTruncation" />
                                                    <Border BackgroundColor="{StaticResource SurfaceContainerHighest}"
                                                            StrokeShape="RoundRectangle 9999" Padding="6,2"
                                                            IsVisible="{Binding EsVip}">
                                                        <Label Text="VIP" Style="{StaticResource LabelSM}"
                                                               TextColor="{StaticResource Outline}" FontSize="8" />
                                                    </Border>
                                                    <Label Text="{x:Static helpers:IconGlyphs.Verified}"
                                                           Style="{StaticResource IconGlyph}" FontSize="15"
                                                           TextColor="{StaticResource Primary}"
                                                           IsVisible="{Binding VerificadoVisible}" />
                                                </HorizontalStackLayout>
                                                <Label Text="{Binding Servicio}" Style="{StaticResource BodySM}"
                                                       TextColor="{Binding ServicioColor}" FontSize="11"
                                                       LineBreakMode="TailTruncation" />
                                                <HorizontalStackLayout Spacing="4" IsVisible="{Binding MetaVisible}">
                                                    <Label Text="{Binding MetaIcono}"
                                                           Style="{StaticResource IconGlyph}" FontSize="13"
                                                           TextColor="{Binding MetaColor}" />
                                                    <Label Text="{Binding Meta}" Style="{StaticResource BodySM}"
                                                           TextColor="{Binding MetaColor}" FontSize="10" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                        </Grid>
                                        <!-- Hora -->
                                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                            <Label Text="{Binding Hora}" FontFamily="BodoniModa" FontSize="20"
                                                   FontAttributes="Bold" TextColor="{Binding HoraColor}"
                                                   HorizontalTextAlignment="End" />
                                            <Label Text="{Binding Periodo}" Style="{StaticResource LabelSM}"
                                                   TextColor="{Binding PeriodoColor}" FontSize="8"
                                                   HorizontalTextAlignment="End" />
                                        </VerticalStackLayout>
                                    </Grid>

                                    <!-- Pie: estado + acción -->
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                                          VerticalOptions="Center" Margin="0,4,0,0">
                                        <Border BackgroundColor="{Binding EstadoPillFondo}"
                                                StrokeShape="RoundRectangle 9999" Padding="10,4"
                                                HorizontalOptions="Start" VerticalOptions="Center">
                                            <HorizontalStackLayout Spacing="5">
                                                <BoxView Color="{Binding EstadoDotColor}"
                                                         WidthRequest="6" HeightRequest="6"
                                                         CornerRadius="3" VerticalOptions="Center" />
                                                <Label Text="{Binding Estado}" Style="{StaticResource LabelSM}"
                                                       TextColor="{Binding EstadoPillTexto}" FontSize="8" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <Button Grid.Column="1"
                                                Text="{Binding AccionTexto}"
                                                Background="{Binding AccionBrush}"
                                                TextColor="{Binding AccionTextoColor}"
                                                FontFamily="PlusJakartaSans" FontSize="10" FontAttributes="Bold"
                                                CharacterSpacing="1" CornerRadius="10" HeightRequest="38"
                                                Padding="18,0" VerticalOptions="Center"
                                                Opacity="{Binding OcupadoOpacity}"
                                                IsVisible="{Binding AccionVisible}"
                                                Command="{Binding BindingContext.AccionCommand, Source={x:Reference Root}}"
                                                CommandParameter="{Binding .}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- ===== Tarjeta informativa de pausa ===== -->
            <Border BackgroundColor="{StaticResource SurfaceContainerLow}"
                    StrokeShape="RoundRectangle 14" Padding="14">
                <Grid ColumnDefinitions="44,*" ColumnSpacing="10">
                    <Border WidthRequest="40" HeightRequest="40" StrokeShape="RoundRectangle 10"
                            BackgroundColor="{StaticResource SurfaceContainerHigh}">
                        <Label Text="{x:Static helpers:IconGlyphs.NotificationsActive}"
                               Style="{StaticResource IconGlyph}" FontSize="20"
                               TextColor="{StaticResource Primary}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                        <Label Text="Tiempo de Pausa Recomendado" Style="{StaticResource TitleMD}"
                               FontSize="14" LineBreakMode="TailTruncation" />
                        <Label Text="Espacio de 15 minutos entre el servicio de Andrés y Gabriel."
                               Style="{StaticResource BodySM}" FontSize="11" />
                    </VerticalStackLayout>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>