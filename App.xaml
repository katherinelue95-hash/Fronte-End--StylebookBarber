<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:StyleBookBarberApp"
             xmlns:helpers="clr-namespace:StyleBookBarberApp.Helpers"
             x:Class="StyleBookBarberApp.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:IsNotNullConverter x:Key="IsNotNullConverter" />
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
            <helpers:IsNotEmptyConverter x:Key="IsNotEmptyConverter" />
            <helpers:IsNotZeroConverter x:Key="IsNotZeroConverter" />
            <helpers:BoolToIntConverter x:Key="BoolToIntConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
